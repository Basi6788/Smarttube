<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#00FF87" android:endColor="#00B4DB" />
            <corners android:radius="18dp" />
            <stroke android:width="2.5dp" android:color="#FFFFFF" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#00E676" android:endColor="#0083B0" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#3300FF87" android:endColor="#3300F2FE" />
            <corners android:radius="18dp" />
            <stroke android:width="1.5dp" android:color="#9900FF87" />
        </shape>
    </item>
</selector>
