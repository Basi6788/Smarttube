<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#00F2FE" android:endColor="#7F00FF" />
            <corners android:radius="18dp" />
            <stroke android:width="2.5dp" android:color="#FFFFFF" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#00C6FF" android:endColor="#6200EA" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:state_hovered="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#00F2FE" android:endColor="#7F00FF" />
            <corners android:radius="18dp" />
            <stroke android:width="1.5dp" android:color="#CCFFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="#2600F2FE" android:endColor="#387F00FF" />
            <corners android:radius="18dp" />
            <stroke android:width="1.5dp" android:color="#8000F2FE" />
        </shape>
    </item>
</selector>
