                android:gradientRadius="650dp"
                android:startColor="#3300F2FE"
                android:centerColor="#147F00FF"
                android:endColor="#00000000"
                android:type="radial" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.15"
                android:centerY="0.85"
                android:gradientRadius="600dp"
                android:startColor="#2800FF87"
                android:centerColor="#120096FF"
                android:endColor="#00000000"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
