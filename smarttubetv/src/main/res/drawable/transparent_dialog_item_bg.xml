<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#4D00F2FE"
                android:endColor="#4D7F00FF"
                android:type="linear" />
            <corners android:radius="18dp" />
            <stroke android:width="2dp" android:color="#FF00F2FE" />
        </shape>
    </item>
    <item android:state_hovered="true">
        <shape android:shape="rectangle">
            <solid android:color="#3300F2FE" />
            <corners android:radius="18dp" />
            <stroke android:width="1.5dp" android:color="#AA00F2FE" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#181E293B" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
