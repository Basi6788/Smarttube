<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#4D00F2FE"
                android:centerColor="#4D7F00FF"
                android:endColor="#3300FF87"
                android:type="linear" />
            <corners android:radius="20dp" />
            <stroke android:width="2dp" android:color="#FF00F2FE" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#3800F2FE"
                android:endColor="#387F00FF"
                android:type="linear" />
            <corners android:radius="20dp" />
            <stroke android:width="1.5dp" android:color="#AA00F2FE" />
        </shape>
    </item>
    <item android:state_hovered="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#3300F2FE"
                android:endColor="#337F00FF"
                android:type="linear" />
            <corners android:radius="20dp" />
            <stroke android:width="1.5dp" android:color="#8800F2FE" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#14FFFFFF" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="#1AFFFFFF" />
        </shape>
    </item>
</selector>
